  // Frozen-egg-lot inventory status for donors offering frozen eggs.
  // AVAILABLE (lots in stock - check numberOfEggs / raw profileData
  // "Frozen Egg Availability" for the low-stock count) | SOLD_OUT (no
  // lots left) | null (pure Fresh Donors with no frozen offering).
  // For "Fresh & Frozen" donors this lives ALONGSIDE the `status` column:
  // status reflects the fresh-cycle matching state, frozenLotStatus
  // reflects the frozen inventory. The marketplace card renders both.
  frozenLotStatus      String?
  /// One sentence lifted verbatim from this person's own writing, chosen by the
  /// enrichment model as the line that says most about who they are. Stored
  /// rather than picked per render: the choice costs a model call, and the same
  /// profile must not quote a different sentence on every page load.
  highlightQuote       String?
  profileData          Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  videoUrl             String?
  cardHash             String?
  lastEditedAt         DateTime?
  lastEditedBy         String?
  manuallyEditedFields String[]                    @default([])
  photos               String[]                    @default([])
  hiddenFromSearch     Boolean                     @default(false)
  isPremium            Boolean                     @default(false)
  isExperienced        Boolean                     @default(false)
  lastFullSyncAt       DateTime?
  // Sponsorship boost (denormalized from Sponsorship/SponsorshipItem; read-hot marketplace flag)
  sponsoredUntil       DateTime?
  sponsorBoostSeed     Int                         @default(0)
  profileEmbedding     Unsupported("vector(768)")?
  // AWS Rekognition look-alike face index: faceIndexedAt stamps when this
  // donor's photos were registered in the face collection; rekognitionFaceIds
  // holds the returned FaceIds so they can be deleted on re-index/removal.
  faceIndexedAt        DateTime?
