generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Provider {
  id                                    String                      @id @default(uuid())
  name                                  String
  about                                 String?
  logoUrl                               String?
  websiteUrl                            String?
  cdcClinicId                           String?
  // CDC ART profile data (synced from data.cdc.gov by cdcClinicId).
  // cdcServices: { donorEgg, donatedEmbryo, embryoCryo, eggCryo, gestationalCarrier, ... : boolean }
  cdcServices                           Json?
  // cdcExperience: { "Diminished ovarian reserve": 38.3, "Male factor": 47.2, ... } - share of
  // this clinic's ART patients by diagnosis (CDC "Reason for Using ART"). Experience/volume signal.
  cdcExperience                         Json?
  // cdcCycleStats: { pgtPct, icsiPct, frozenPct, singleEmbryoPct, gestationalCarrierPct, fertilityPreservationPct }
  cdcCycleStats                         Json?
  // CDC-reported medical director, e.g. "William B. Schoolcraft, MD". Durable
  // fallback: enrichment recreates this as a member whenever a clinic would
  // otherwise end with zero doctors (network labs SART can't match by name).
  cdcMedicalDirector                    String?
  email                                 String?
  /// Where surrogate availability-verification requests are sent. The general
  /// `email` is usually an ops inbox; these requests need the person who
  /// actually knows whether a surrogate is still free. Falls back to `email`
  /// when unset - see docs/surrogate-availability-verification.md.
  surrogateCoordinatorEmail             String?
  phone                                 String?
  yearFounded                           Int?
  // Doctor/clinic marketplace enrichment (provider self-entry + concepts borrowed from FertilityIQ/ZocDoc)
  acceptedInsurance                     String[]                    @default([]) // provider self-entry; powers the insurance filter
  lgbtqCare                             Boolean                     @default(false)
  offersVideoVisits                     Boolean                     @default(true)
  // Review aggregates (computed from GoStork verified reviews; never external)
  reviewCount                           Int                         @default(0)
  recommendPct                          Int?
  avgOverallScore                       Decimal?
  createdAt                             DateTime                    @default(now())
  updatedAt                             DateTime                    @updatedAt
  isTestData                            Boolean                     @default(false)
  brandingEnabled                       Boolean                     @default(false)
  consultationBookingUrl                String?
  consultationIframeEnabled             Boolean                     @default(false)
  agreementTemplateUrl                  String?
  agreementTemplateOriginalName         String?
  pandaDocTemplateId                    String?
  pandaDocRoles                         String? // JSON array of role names in signing order, e.g. ["Client","Client2","Agency"]
  // Phase 5 agreement automation mode, set by the PROVIDER (overrides the
  // GoStork-admin autoAgreementDraft rollout toggle):
  //   null       = inherit admin toggle (on -> "approval", off -> "off")
  //   "off"      = never auto-draft on invoice PAID
  //   "approval" = auto-draft, provider approves before send
  //   "auto_send" = fully automated - generate AND send for signature on PAID
  agreementAutomation                   String?
  // Look-alike face matching: the agency authorizes GoStork to generate
  // faceprints from its donors'/surrogates' photos. Default ON (opt-out) -
  // backed by the agency agreement's biometric rep/warranty; agencies that
  // lack donor consent turn it OFF, which removes their faceprints.
  // See docs/biometric-consent-donor-terms.md and [[project_lookalike_face_matching]].
  biometricMatchingAuthorized           Boolean                     @default(true)
  // Intended Parent Form: does this provider collect it (prompt the parent +
  // download it), and does it require a photocopy of each parent's ID document.
  // For surrogacy agencies this is ALWAYS true (auto-healed server-side);
  // the checkbox is an opt-in only for other provider types (IVF clinics).
  collectsIntendedParentForm            Boolean                     @default(false)
  // DEPRECATED (Aug 13 2026): the ID requirement is now the per-provider
  // visibility of the priv_id_photocopy question (IpFormProviderOverride) -
  // see providerRequiresIdPhotocopy(). Column kept for history, never read.
  requiresIdPhotocopy                   Boolean                     @default(false)
  // GoStork-controlled: may this provider edit its own Parent Form
  // adjustments (per-provider overrides + custom questions)? Toggled only by
  // GoStork admins from the admin provider Parent Form tab.
  canEditParentForm                     Boolean                     @default(false)
  biometricMatchingAuthorizedAt         DateTime?
  // Legal Services Phase 1: states the firm is licensed in (USPS codes,
  // e.g. ["CA","NY"]). Drives Stage 3a state-match check for LAWYER
  // providers and Eva's lawyer-introduction filter.
  statesLicensedIn                      String[]                    @default([])
  // Phase 2 automation flags. JSON shape:
  //   { autoCostSheetDraft?: boolean, autoInvoiceDraft?: boolean, autoAgreementDraft?: boolean }
  // null = all off. Flipped by GoStork admins only via the admin
  // provider settings page. Gate-2 on top of the global
  // ConciergePromptSection.isActive kill switch.
  autoFeaturesEnabled                   Json?
  // IVF Clinic matching requirements
  ivfTwinsAllowed                       Boolean                     @default(false)
  // null = clinic hasn't answered (unknown skips the matching rule)
  ivfGenderSelectionAllowed             Boolean?
  ivfTransferFromOtherClinics           Boolean                     @default(false)
  ivfMaxAgeIp1                          Int?
  ivfMaxAgeIp2                          Int?
  ivfBiologicalConnection               String?
  ivfAcceptingPatients                  Json?
  ivfEggDonorType                       String?
  // IVF Clinic surrogate matching requirements
  ivfSurrogateMinAge                    Int?
  ivfSurrogateMaxAge                    Int?
  ivfSurrogateMinBmi                    Float?
  ivfSurrogateMaxBmi                    Float?
  ivfSurrogateMinDeliveries             Int?
  ivfSurrogateMaxDeliveries             Int?
  ivfSurrogateMaxCSections              Int?
  ivfSurrogateMaxMiscarriages           Int?
  ivfSurrogateMaxAbortions              Int?
  ivfSurrogateMaxYearsFromLastPregnancy Int?
  ivfSurrogateMonthsPostVaginal         Int?
  ivfSurrogateCovidVaccination          Boolean?
  ivfSurrogateGdDiet                    Boolean?
  ivfSurrogateGdMedication              Boolean?
  ivfSurrogateHighBloodPressure         Boolean?
  ivfSurrogatePlacentaPrevia            Boolean?
  ivfSurrogatePreeclampsia              Boolean?
  ivfSurrogateMentalHealthHistory       String?
  // Surrogacy Agency matching requirements
  partnerProviderIds                    Json? // Array of linked partner provider IDs. On a surrogacy agency: its partner IVF clinics (bundled costs + two-call booking, domestic or international). On an IVF clinic: the surrogacy agencies it works with EXCLUSIVELY (the AI only offers these to that clinic's parents).
  surrogacyCitizensNotAllowed           Json?
  surrogacyTwinsAllowed                 Boolean                     @default(false)
  surrogacyStayAfterBirthMonths         Int?
  surrogacyBirthCertificateListing      Json?
  surrogacySurrogateRemovableFromCert   Boolean?
  // Billing settings
  depositMilestone                      String? // "AT_MATCH" | "AT_CLEARANCE" (surrogacy agencies only)
  averageClearanceDays                  Int? // used for AT_CLEARANCE milestone scheduling
  eggDonors                             EggDonor[]
  agreements                            Agreement[]
  agreementTemplates                    ProviderAgreementTemplate[]
  eggDonorSyncConfig                    EggDonorSyncConfig?
  brandSettings                         ProviderBrandSettings?
  legalIdentity                         ProviderLegalIdentity?
  costSheets                            ProviderCostSheet[]
  costPrograms                          CostProgram[]
  locations                             ProviderLocation[]
  members                               ProviderMember[]
  services                              ProviderService[]
  spermDonors                           SpermDonor[]
  spermDonorSyncConfig                  SpermDonorSyncConfig?
  surrogacyProfile                      SurrogacyAgencyProfile?
  surrogates                            Surrogate[]
  surrogateSyncConfig                   SurrogateSyncConfig?
  users                                 User[]
  ivfSuccessRates                       IvfSuccessRate[]
  reviews                               ProviderReview[]
  knowledgeChunks                       KnowledgeChunk[]
  silentQueries                         SilentQuery[]
  chatSessions                          AiChatSession[]
  syncLogs                              SyncLog[]
  profileEmbedding                      Unsupported("vector(768)")?
  referralFeeConfigs                    ReferralFeeConfig[]
  invoices                              Invoice[]
  providerQuotes                        ProviderQuote[]
  bankAccount                           ProviderBankAccount?
  w9                                    ProviderW9?
  gostorkAgreements                     ProviderAgreement[]
  // Profile sponsorship: when sponsoredUntil > now() the provider's own top-level
  // profile (clinic/agency) is boosted in the marketplace. sponsorBoostSeed is
  // bumped on each (de)activation to drive the rotating sponsored-order shuffle.
  sponsoredUntil                        DateTime?
  sponsorBoostSeed                      Int                         @default(0)
  sponsorships                          Sponsorship[]
  // Provider-level Stripe customer for sponsorship billing. Shared across the
  // provider's billing users so a saved card entered once is reused for every
  // future sponsorship charge (Option B: enter payment method once, auto-charge).
  sponsorStripeCustomerId               String?
  autoReplies                           ProviderAutoReply[]
  autoReplySends                        ProviderAutoReplySend[]
  parentBriefings                       ProviderParentBriefing[]
  parentContactReleases                 ParentContactRelease[]
  parentNotes                           ParentNote[]
  parentTasks                           ParentTask[]
  parentOwners                          ParentOwner[]
  taskPlaybooks                         TaskPlaybook[]
}

/// Send log for the AI-written private parent briefing. Same "once per parent
/// + provider + service line" rule as the auto-reply, and the same COALESCE
/// unique index (see the migration) - a plain unique would not dedupe because
/// NULL <> NULL in Postgres.
model ProviderParentBriefing {
  id              String   @id @default(uuid())
  providerId      String
  parentAccountId String?
  parentUserId    String
  providerTypeId  String?
  sessionId       String
  bookingId       String?
  /// The posted AiChatMessage, so the briefing can be found from the log.
  messageId       String?
  sentAt          DateTime @default(now())
  provider        Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, parentAccountId])
  @@index([providerId, parentUserId])
}

/// A provider-authored first message that is posted into the parent's 3-way
/// chat automatically the moment that parent books a call with them. Scope is
/// resolved from most-specific to least: staff+service -> staff-any ->
/// org+service -> org-any. A null staffUserId means "organization default";
/// a null providerTypeId means "any service line this org runs".
model ProviderAutoReply {
  id              String                  @id @default(uuid())
  providerId      String
  staffUserId     String?
  providerTypeId  String?
  body            String
  /// [{ originalName, url, mimeType, size }] - same shape the chat
  /// attachment card already renders, produced by /api/chat-upload.
  attachments     Json                    @default("[]")
  isEnabled       Boolean                 @default(true)
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  provider        Provider                @relation(fields: [providerId], references: [id])
  staffUser       User?                   @relation("AutoReplyStaff", fields: [staffUserId], references: [id])
  providerType    ProviderType?           @relation(fields: [providerTypeId], references: [id])
  sends           ProviderAutoReplySend[]

  @@index([providerId])
  @@index([providerId, staffUserId])
}

/// Send log for the "once per parent + provider + service type" rule. Also the
/// cross-process idempotency guard: both Macs run the schedulers against the
/// same DB, and a double-booking POST must not double-post the greeting.
model ProviderAutoReplySend {
  id              String             @id @default(uuid())
  autoReplyId     String?
  providerId      String
  /// Account-scoped so a second member of the same parent account does not
  /// re-trigger the greeting. Falls back to parentUserId for solo parents.
  parentAccountId String?
  parentUserId    String
  providerTypeId  String?
  sessionId       String
  bookingId       String?
  sentAt          DateTime           @default(now())
  autoReply       ProviderAutoReply? @relation(fields: [autoReplyId], references: [id])
  provider        Provider           @relation(fields: [providerId], references: [id])

  @@index([providerId, parentAccountId])
  @@index([providerId, parentUserId])
}

model ProviderType {
  id            String              @id @default(uuid())
  name          String              @unique
  costTemplates CostTemplate[]
  services      ProviderService[]
  costSheets    ProviderCostSheet[]
  autoReplies   ProviderAutoReply[]
}

model ProviderService {
  id             String       @id @default(uuid())
  providerId     String
  providerTypeId String
  status         String       @default("NEW")
  provider       Provider     @relation(fields: [providerId], references: [id])
  providerType   ProviderType @relation(fields: [providerTypeId], references: [id])

  @@unique([providerId, providerTypeId])
  @@index([providerTypeId, status])
}

model ProviderLocation {
  id            String                   @id @default(uuid())
  providerId    String
  address       String?
  city          String?
  state         String?
  zip           String?
  sortOrder     Int                      @default(0)
  provider      Provider                 @relation(fields: [providerId], references: [id])
  members       ProviderMemberLocation[]
  userLocations UserLocation[]

  @@index([providerId])
}

model IvfSuccessRate {
  id              String   @id @default(uuid())
  providerId      String
  year            Int      @default(0)
  profileType     String
  metricCode      String
  submetric       String?
  ageGroup        String?
  isNewPatient    Boolean  @default(false)
  successRate     Decimal
  cycleCount      Int      @default(0)
  percentile      Decimal  @default(0)
  top10pct        Boolean  @default(false)
  nationalAverage Decimal  @default(0)
  provider        Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, year])
}

model CdcDatasetMap {
  year      Int    @id
  datasetId String
}

model CdcSyncJob {
  id                     String    @id @default(uuid())
  year                   Int
  status                 String    @default("PENDING")
  clinicsProcessed       Int       @default(0)
  recordsProcessed       Int       @default(0)
  estimatedTotalRecords  Int?
  estimatedTotalClinics  Int?
  errorMessage           String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  enrichmentStatus       String?
  enrichmentMode         String?
  enrichmentProcessed    Int       @default(0)
  enrichmentTotal        Int       @default(0)
  enrichmentErrors       Int       @default(0)
  enrichmentSkipped      Int       @default(0)
  enrichmentErrorMessage String?
  resumeAttempts         Int       @default(0)
}

model RawCdcData {
  id           String @id @default(uuid())
  year         Int
  facilityName String
  rawData      Json

  @@index([year])
}

model ParentAccount {
  id                            String                 @id @default(uuid())
  createdAt                     DateTime               @default(now())
  customEthnicities             String[]               @default([])
  customFilterTags              Json                   @default("{}")
  preferredAppExperience        String?
  // Marketplace "New" badge watermark. WatermarkAt is the timestamp used
  // as the cutoff: a profile is "New" iff createdAt > marketplaceWatermarkAt
  // AND not in the ParentProfileView set. WatermarkUpdatedAt is when the
  // marketplace was last opened by this account; if more than 30 min have
  // passed since then, the next visit slides marketplaceWatermarkAt to
  // that previous value (= the actual "last visit"). Reloads within 30 min
  // don't slide the watermark, so the parent keeps seeing the same set of
  // "New" badges throughout a browsing session.
  marketplaceWatermarkAt        DateTime?
  marketplaceWatermarkUpdatedAt DateTime?
  members                       User[]
  intendedParentProfile         IntendedParentProfile?
  journeyPreferences            JourneyPreferences?
  profileViews                  ParentProfileView[]
}

// Tracks which donor/surrogate profiles a parent account has already "seen"
// so the marketplace's "New" badge can disappear per-profile on first
// interaction. A profile is marked New iff it was created in the last 24h
// AND no view row exists here. Triggers that create a row: tapping a card
// to expand, hearting/passing it, scrolling past it (>=1s in viewport),
// or having it surfaced as an AI [[MATCH_CARD]]. Scoped at the parent
// ACCOUNT level so all members of a shared account share "seen" state.
model ParentProfileView {
  id              String        @id @default(uuid())
  parentAccountId String
  parentAccount   ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  profileId       String
  profileType     String // "egg-donor" | "surrogate" | "sperm-donor"
  viewedAt        DateTime      @default(now())

  @@unique([parentAccountId, profileId, profileType])
  @@index([parentAccountId, viewedAt])
}

// Periodic "search visibility" snapshot: where a sponsored profile ranks in its
// marketplace deck WITH the boost (position) vs where it would rank organically
// (organicPosition). Written by a scheduled job, not the live request path, so it
// never touches the hot marketplace read path. Powers the dashboard lift metric.
model SponsoredRankSnapshot {
  id              String   @id @default(uuid())
  providerId      String
  profileId       String
  entityType      String // EGG_DONOR | SURROGATE | SPERM_DONOR | DOCTOR
  position        Int // boosted (actual) deck position, 1-based
  organicPosition Int // position without the sponsorship boost, 1-based
  poolSize        Int // total marketplace-visible profiles of this type
  createdAt       DateTime @default(now())

  @@index([providerId, createdAt])
}

// One row per chat session in which the parent actively engaged (sent a message)
// about a specific profile - the profile on screen (latest match card) when they
// messaged. Captures mid-conversation inquiries per profile; analytics filters to
// the sponsored subset. Deduped per (session, profile).
model ProfileInquiry {
  id         String   @id @default(uuid())
  sessionId  String
  profileId  String
  entityType String
  createdAt  DateTime @default(now())

  @@unique([sessionId, profileId])
  @@index([profileId, createdAt])
}

// Append-only ad-funnel event log for marketplace profiles. Unlike
// ParentProfileView (which is deduped per parent and powers the "New" badge),
// this is NOT deduped - it records every display and every click so the
// sponsorship dashboard can report true impressions (Google-style: counted
// each time a profile is shown) plus unique reach (distinct parentAccountId)
// and click-through (eventType = "VIEW"). profileType spans every marketplace
// entity: egg-donor | surrogate | sperm-donor | doctor | clinic | agency.
model ProfileEvent {
  id              String   @id @default(uuid())
  parentAccountId String
  profileId       String
  profileType     String
  eventType       String // "IMPRESSION" (shown) | "VIEW" (opened full profile)
  createdAt       DateTime @default(now())

  @@index([profileId, eventType, createdAt])
  @@index([profileId, createdAt])
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  /// Normalised form of email for alias/dedup detection (gmail dots+tags stripped). Nullable on rows created before this existed.
  emailCanonical         String?
  /// Signup risk state: TRUSTED (default) | PENDING | QUARANTINED. Quarantined = exists but gated from sensitive actions.
  trustState             String                  @default("TRUSTED")
  /// Reasons the signup was flagged (ip_velocity, no_turnstile, ...), for the /parents review queue.
  trustReasons           String[]                @default([])
  /// Source IP at signup (first x-forwarded-for hop), for per-IP velocity checks.
  signupIp               String?
  /// #2b Merge: set on every login of an absorbed account, pointing at the
  /// surviving record's primary user, so old links still resolve.
  mergedIntoUserId       String?
  password               String?
  name                   String?
  firstName              String?
  lastName               String?
  photoUrl               String?
  mobileNumber           String?
  mobileNumberDisplay    String?
  /// A2P 10DLC: separate opt-in for the ongoing notification SMS stream (match updates,
  /// appointment notices, provider messages). OTP verification codes are transactional and
  /// NOT gated by this. Must default false - a pre-checked box is its own A2P violation.
  smsNotificationsOptIn  Boolean                 @default(false)
  dateOfBirth            DateTime?
  gender                 String?
  partnerGender          String?
  sexualOrientation      String?
  relationshipStatus     String?
  partnerFirstName       String?
  partnerAge             Int?
  referralSource         String?
  roles                  String[]                @default(["PARENT"])
  providerId             String?
  allLocations           Boolean                 @default(false)
  mustCompleteProfile    Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  dailyRoomUrl           String?
  calendarLink           String?
  isDisabled             Boolean                 @default(false)
  parentAccountId        String?
  parentAccountRole      String?
  city                   String?
  country                String?
  state                  String?
  address                String?
  zip                    String?
  ssn                    String?
  passport               String?
  passportCountryOfIssue String?
  nationality            String?
  // Stripe Customer id - lazily created the first time the parent triggers a
  // payment method that requires it (currently: bank-transfer / customer_balance).
  // Card payments still go through guest checkout and do not populate this.
  stripeCustomerId       String?                 @unique
  availabilityOverrides  AvailabilityOverride[]
  bookingsAsParent       Booking[]               @relation("ParentBookings")
  bookingsAsProvider     Booking[]               @relation("ProviderBookings")
  calendarBlocks         CalendarBlock[]
  calendarConnections    CalendarConnection[]
  eventFreeOverrides     EventFreeOverride[]
  notifications          Notification[]
  scheduleConfig         ScheduleConfig?
  parentAccount          ParentAccount?          @relation(fields: [parentAccountId], references: [id])
  provider               Provider?               @relation(fields: [providerId], references: [id])
  assignedLocations      UserLocation[]
  passwordResetTokens    PasswordResetToken[]
  donorPreferences       UserDonorPreference[]
  profilePreferences     UserProfilePreference[]
  costSheetQuotes        ProviderCostSheet[]     @relation("CostSheetQuotes")
  inAppNotifications     InAppNotification[]
  aiChatSessions         AiChatSession[]
  silentQueries          SilentQuery[]           @relation("SilentQueryParent")
  agreements             Agreement[]
  invoices               Invoice[]
  providerQuotes         ProviderQuote[]         @relation("ProviderQuoteParent")
  createdProviderQuotes  ProviderQuote[]         @relation("ProviderQuoteCreatedBy")
  reservedSurrogates     Surrogate[]             @relation("SurrogateReservations")
  autoReplies            ProviderAutoReply[]     @relation("AutoReplyStaff")
  parentOwnerships       ParentOwner[]           @relation("ParentOwnerUser")
  @@index([emailCanonical])
  @@index([signupIp])
}

model UserDonorPreference {
  id        String   @id @default(uuid())
  userId    String
  donorId   String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, donorId, type])
  @@index([userId, type])
}

// Phase 6: saved/passed preferences for providers (doctors keyed by slug,
// clinics keyed by providerId). Generic entityType so future entity kinds can
// reuse it. Mirrors UserDonorPreference; kept separate so donor logic is untouched.
model UserProfilePreference {
  id         String   @id @default(uuid())
  userId     String
  entityType String // "doctor" | "clinic"
  entityId   String // doctor slug | clinic providerId
  type       String // "favorite" | "skip"
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId, type])
  @@index([userId, entityType, type])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLocation {
  id         String           @id @default(uuid())
  userId     String
  locationId String
  location   ProviderLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

model SurrogacyAgencyProfile {
  id                     String              @id @default(uuid())
  providerId             String              @unique
  numberOfBabiesBorn     Int?
  timeToMatch            String?
  familiesPerCoordinator Int?
  provider               Provider            @relation(fields: [providerId], references: [id])
  screening              SurrogateScreening?
}

model SurrogateScreening {
  id                       String                 @id @default(uuid())
  surrogacyProfileId       String                 @unique
  criminalBackgroundCheck  Boolean                @default(false)
  homeVisits               Boolean                @default(false)
  financialsReview         Boolean                @default(false)
  socialWorkerScreening    Boolean                @default(false)
  medicalRecordsReview     Boolean                @default(false)
  surrogateInsuranceReview Boolean                @default(false)
  psychologicalScreening   Boolean                @default(false)
  surrogacyProfile         SurrogacyAgencyProfile @relation(fields: [surrogacyProfileId], references: [id])
}

model ProviderMember {
  id                      String                   @id @default(uuid())
  providerId              String
  name                    String
  title                   String?
  bio                     String?
  // Full text of the doctor's own profile page, stored verbatim. `bio` is the
  // short display summary; structured extraction (education / languages /
  // specialties) reads THIS instead, because summarizing the page is exactly
  // what drops the "Education and Experience" and "Languages" sections.
  bioRaw                  String?
  photoUrl                String?
  highResPhotoUrl         String? // AI-upscaled crisp variant of photoUrl (GCS). Preferred when present; original kept for lineage.
  isMedicalDirector       Boolean                  @default(false)
  sortOrder               Int                      @default(0)
  // Doctor profile: identity / addressability
  slug                    String?                  @unique // e.g. "vicken-sahakian"
  personKey               String? // normalized-name hash; links the same human across multiple clinics
  isPublicProfile         Boolean                  @default(true) // false hides non-doctor staff from the public doctor page
  // Doctor profile: credentials (from clinic-site enrichment + provider self-entry)
  specialties             String[]                 @default([]) // e.g. "Male Factor","LGBTQ+ Family Building","PCOS","Recurrent Loss"
  languagesSpoken         String[]                 @default([])
  boardCertifications     String[]                 @default([])
  education               String[]                 @default([]) // ["Med School - ...","Residency - ...","Fellowship - ..."]
  professionalMemberships String[]                 @default([])
  npiNumber               String?
  npiTaxonomy             String? // authoritative specialty classification from NPPES, e.g. "Reproductive Endocrinology"
  credential              String? // MD, DO (from NPPES)
  licenseState            String? // primary license state (from NPPES)
  medicalSchool           String? // from state boards / CMS when available
  graduationYear          Int?
  // Per-field provenance: { field: "nppes" | "cms" | "abog" | "bio" | "self" }.
  // Higher-confidence sources never overwrite human (self) entries.
  fieldSources            Json?
  yearsExperience         Int?
  providerGender          String?
  offersVideoVisits       Boolean                  @default(false)
  acceptingNewPatients    Boolean                  @default(true)
  // Doctor profile: review aggregates (computed from GoStork verified reviews; never external)
  reviewCount             Int                      @default(0)
  recommendPct            Int? // 0-100 "% would recommend"
  avgOverallScore         Decimal? // 0-10 composite
