  spermDonorType            String?
  spermDonorPreferences     String?
  spermDonorAgeRange        String?
  spermDonorEyeColor        String?
  spermDonorHairColor       String?
  spermDonorHeightRange     String?
  spermDonorRace            String?
  spermDonorEthnicity       String?
  spermDonorEducation       String?
