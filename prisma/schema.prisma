// ==========================================
// AI CONCIERGE & CHAT HISTORY MODELS
// ==========================================

model AiChatSession {
  id               String    @id @default(uuid())
  userId           String
  title            String?
  status           String    @default("ACTIVE")
  sessionType      String    @default("PARENT")
  humanRequested   Boolean   @default(false)
  humanJoinedAt    DateTime?
  humanConcludedAt DateTime?
  humanAgentId     String?
  providerId       String?
  providerJoinedAt DateTime?
  providerName     String?
  profilePhotoUrl  String?
  subjectProfileId String?
  subjectType      String?
  matchmakerId     String?
  tier2Active      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages           AiChatMessage[]
  silentQueries      SilentQuery[]
  agreements         Agreement[]
  invoices           Invoice[]
  providerQuotes     ProviderQuote[]
  costSheetReminders CostSheetReminder[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           Provider?           @relation(fields: [providerId], references: [id])

  @@index([userId])
  @@index([humanRequested])
  @@index([providerId])
  @@index([sessionType])
  @@index([providerId, subjectProfileId])
}

model AiChatMessage {
  id          String    @id @default(uuid())
  sessionId   String
  role        String
  content     String
  senderType  String    @default("ai")
  senderName  String?
  uiCardType  String?
  uiCardData  Json?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

