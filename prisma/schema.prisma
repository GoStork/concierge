  surrogateTotalCostRange       String?
  surrogateLiveBirthsRange      String?
  surrogateMaxCSections         Int?
  surrogateMaxMiscarriages      Int?
  surrogateMaxAbortions         Int?
  surrogateLastDeliveryYear     Int?
  surrogateCovidVaccinated      Boolean?
  surrogateSelectiveReduction   Boolean?
  surrogateInternationalParents Boolean?

