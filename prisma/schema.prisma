// ==========================================
// PANDADOC AGREEMENT TRACKING
// ==========================================

// Per-service agreement templates for multi-service providers (e.g. an
// agency doing both SURROGACY and EGG_DONATION has a different contract per
// service). Falls back to the legacy single-template fields on Provider
// (agreementTemplateUrl / pandaDocTemplateId / pandaDocRoles) when no row
// exists for the session's service type.
model ProviderAgreementTemplate {
  id                            String   @id @default(uuid())
  providerId                    String
  serviceType                   String // SURROGACY | EGG_DONATION | SPERM_DONATION | IVF_CLINIC | OTHER
  agreementTemplateUrl          String?
  agreementTemplateOriginalName String?
  pandaDocTemplateId            String?
  pandaDocRoles                 String? // JSON array of role names in signing order
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceType])
}

model Agreement {
  id                 String    @id @default(uuid())
  providerId         String
  parentUserId       String
  sessionId          String
  serviceType        String? // which service's template generated this agreement (SURROGACY / EGG_DONATION / ...)
  generatedByUserId  String? // userId of the provider staff member who clicked Generate & Send Agreement
  pandaDocDocumentId String?   @unique
  pandaDocViewUrl    String?
  status             String    @default("DRAFT")
  documentType       String    @default("Agency Agreement")
  signerStatus       Json? // { "email": { completed: boolean, completedAt: string|null, role: string|null, firstName: string|null, lastName: string|null } }
  guestSigningTokens Json? // { "token": "email" } - one-time tokens for non-GoStork signers
  signerOrder        Json? // [{ email, name, userId, guestToken, signingOrder, notified }] ordered list for sequential notifications
  invoiceId          String?   @unique // GoStork payment gate - must be PAID before agreement can be signed
  signedAt           DateTime?
  rejectedAt         DateTime?
  // Origin app URL captured at generation time. Used by webhook handlers
  // when notifying subsequent signers, so the URL in the email matches
  // the environment the agency generated from - regardless of which
  // server (local, Replit, prod) wins the PandaDoc webhook race.
  originAppUrl       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  provider   Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  parentUser User          @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  session    AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([providerId])
  @@index([parentUserId])
  @@index([sessionId])
}

