model Notification {
  id           String    @id @default(uuid())
  userId       String
  bookingId    String?
  type         String
  channel      String
  sentAt       DateTime?
  scheduledFor DateTime?
  status       String    @default("pending")
  recipient    String
  // What was actually sent. Written at dispatch, where the rendered message
  // is in hand - nothing reconstructs it afterwards, because buildBrandedEmail
  // resolves brand settings, links and tokens at send time and those change.
  // Null on every row written before this existed; the UI says so rather than
  // inventing a body.
  subject      String?
  bodyHtml     String?   @db.Text
  bodyText     String?   @db.Text
  // Cross-process send guard. Two servers run the same crons, so a sweep that
  // reads "not sent yet" on both machines used to send the same email twice in
  // the same second. This key fingerprints (channel, recipient, booking,
  // rendered content, 10-min window); the unique index makes the SECOND insert
  // fail, so the duplicate is never handed to SendGrid/Twilio. Null on rows
  // written before this existed - Postgres allows many nulls in a unique index.
  dedupeKey    String?   @unique
  createdAt    DateTime  @default(now())
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

