  subjectProfileId String?
  subjectType      String?
  matchmakerId     String?
  tier2Active      Boolean   @default(false)
  isTestData       Boolean   @default(false)
  // Phase 1 Stage 13: stamped when the parent has paid the deposit AND
  // the agreement is fully signed, signalling GoStork's portion of the
  // workflow is complete and the provider has taken over.
