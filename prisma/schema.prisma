// GoStork-owned verified reviews for clinics and doctors. Data is captured from
// our own post-consultation flow (only users who booked can review) - never
// scraped from FertilityIQ/ZocDoc. Structure (recommend buckets, sub-dimension
// scores, treatment metadata tags) is modeled after those sites; the data is ours.
// Durable CROSS-THREAD concierge memory (ported from AI-Health's UserMemory):
// small, parent-visible/editable facts about the family (soft preferences,
// constraints, decisions, personal context) injected into EVERY session of the
// account - the Eva chat AND provider threads. Holds only what the structured
// IntendedParentProfile ([[SAVE]] fields) can't. Newer conflicting facts
// supersede old ones (active=false), and the parent can view/edit/delete
// everything on their Profile page so stale memories never fester.
model ConciergeMemory {
  id              String   @id @default(uuid())
  parentAccountId String
  kind            String   @default("FACT") // PREFERENCE | CONSTRAINT | GOAL | FACT | DECISION
  text            String
  source          String   @default("MANUAL") // CHAT_AUTO | USER_SAID | MANUAL
