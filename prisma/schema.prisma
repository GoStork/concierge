model CostProgram {
  id             String              @id @default(uuid())
  providerId     String
  providerTypeId String?
  // tab: "ivf_cycle" | "shipping_embryos" | "shipping_eggs_sperm" | "egg_freezing"
  tab            String?
  // subType: legacy single-leaf value. Kept for backwards compat - new code
  // should read subTypes[] (plural) below. Save paths write both: subTypes[0]
  // back into subType so legacy readers keep working.
  subType        String?
  // subTypes: canonical multi-leaf coverage. Each entry is a flat leaf from
  // cost-templates-config (e.g. "surrogacy", "egg_donor_fresh", "egg_donor_frozen",
  // "sperm_donor", or one of the 14 IVF SubType ids). A single combined-package
  // program (e.g. surrogacy + fresh egg donation) gets multiple leaves; the
  // auto-draft matcher queries with hasSome against the parent's eligible
  // leaves. Empty array means the program is unconfigured for auto-draft.
  subTypes       String[]            @default([])
  // serviceTypes: legacy "service tag" multi-select ("surrogacy" | "egg_donor"
  // | "sperm_donor" | "ivf_clinic"). Derivable from subTypes (each leaf maps
  // to one service tag); kept for filters that still read it.
  serviceTypes   String[]            @default([])
  name           String
  country        String
  createdAt      DateTime            @default(now())
  costSheets     ProviderCostSheet[]
  provider       Provider            @relation(fields: [providerId], references: [id])
}

model ProviderCostSheet {
  id               String        @id @default(uuid())
  providerId       String
  providerTypeId   String?
  parentClientId   String?
  // tab: "ivf_cycle" | "shipping_embryos" | "shipping_eggs_sperm" | "egg_freezing"
  tab              String?
  // subType: legacy single-leaf value. Kept for backwards compat. New code
  // reads subTypes[] (plural). Save paths write subTypes[0] back into subType.
  subType          String?
  // subTypes: canonical multi-leaf coverage. See CostProgram.subTypes above
  // for the leaf taxonomy. Auto-draft queries with hasSome.
  subTypes         String[]      @default([])
  programId        String?
  fileUrl          String?
  filePath         String?
  originalFileName String?
  status           String        @default("PENDING")
  adminFeedback    String?
  version          Int           @default(1)
  // Phase 3 auto-invoice draft pre-fill template
  category         String?
  description      String?
  lineItemTemplate Json?
  // Fixed-vs-not-fixed classification. null = AI has not run yet (or the
  // admin hasn't picked). When true, the overlay's mandatoryFixed[] fields
  // become required on submit.
  isFixedCost      Boolean?
  // Live progress for the background Gemini parse. Updated by the
  // controller's backgroundParseAndSave as the AI streams items back.
  // parseStage is a short human label ("Reading document...",
  // "Extracting items (12 found)", "Mapping to template", ...).
  // parseProgress is 0-100. parseItemsCount lets the UI render a live
  // "X items extracted so far" counter while status is still PARSING.
  parseStage       String?
  parseProgress    Int?          @default(0)
  parseItemsCount  Int?          @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            CostItem[]
  provider         Provider      @relation(fields: [providerId], references: [id])
  providerType     ProviderType? @relation(fields: [providerTypeId], references: [id])
  parentClient     User?         @relation("CostSheetQuotes", fields: [parentClientId], references: [id])
  program          CostProgram?  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

