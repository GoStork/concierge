model CostProgram {
  id             String              @id @default(uuid())
  providerId     String
  providerTypeId String?
  // tab: "ivf_cycle" | "shipping_embryos" | "shipping_eggs_sperm" | "egg_freezing"
  tab            String?
  // subType: legacy single-leaf value. Kept for backwards compat - new code
  // should read subTypes[] (plural) below. Save paths write both: subTypes[0]
  // back into subType so legacy readers keep working.
  subType        String?
  // subTypes: canonical multi-leaf coverage. Each entry is a flat leaf from
  // cost-templates-config (e.g. "surrogacy", "egg_donor_fresh", "egg_donor_frozen",
  // "sperm_donor", or one of the 14 IVF SubType ids). A single combined-package
  // program (e.g. surrogacy + fresh egg donation) gets multiple leaves; the
  // auto-draft matcher queries with hasSome against the parent's eligible
  // leaves. Empty array means the program is unconfigured for auto-draft.
  subTypes       String[]            @default([])
  // serviceTypes: legacy "service tag" multi-select ("surrogacy" | "egg_donor"
  // | "sperm_donor" | "ivf_clinic"). Derivable from subTypes (each leaf maps
  // to one service tag); kept for filters that still read it.
  serviceTypes   String[]            @default([])
  name           String
  country        String
  createdAt      DateTime            @default(now())
  costSheets     ProviderCostSheet[]
  provider       Provider            @relation(fields: [providerId], references: [id])
}

model ProviderCostSheet {
  id               String        @id @default(uuid())
  providerId       String
  providerTypeId   String?
  parentClientId   String?
  // tab: "ivf_cycle" | "shipping_embryos" | "shipping_eggs_sperm" | "egg_freezing"
  tab              String?
  // subType: legacy single-leaf value. Kept for backwards compat. New code
  // reads subTypes[] (plural). Save paths write subTypes[0] back into subType.
  subType          String?
  // subTypes: canonical multi-leaf coverage. See CostProgram.subTypes above
  // for the leaf taxonomy. Auto-draft queries with hasSome.
  subTypes         String[]      @default([])
  programId        String?
  fileUrl          String?
  filePath         String?
  originalFileName String?
  status           String        @default("PENDING")
  adminFeedback    String?
  version          Int           @default(1)
  // Phase 3 auto-invoice draft pre-fill template
  category         String?
  description      String?
  lineItemTemplate Json?
  // Fixed-vs-not-fixed classification. null = AI has not run yet (or the
  // admin hasn't picked). When true, the overlay's mandatoryFixed[] fields
  // become required on submit.
  isFixedCost      Boolean?
  // Live progress for the background Gemini parse. Updated by the
  // controller's backgroundParseAndSave as the AI streams items back.
  // parseStage is a short human label ("Reading document...",
  // "Extracting items (12 found)", "Mapping to template", ...).
  // parseProgress is 0-100. parseItemsCount lets the UI render a live
  // "X items extracted so far" counter while status is still PARSING.
  parseStage       String?
  parseProgress    Int?          @default(0)
  parseItemsCount  Int?          @default(0)
  // Sheet-level payment terms that aren't tied to a single tranche:
  //   { escrowFloorCents, replenishDays, refundPolicy, quoteValidDays,
  //     acceptedMethods: string[], cardFeePercent, notes }
  // Escrow floors ("balance shall not fall under $10k at any given moment"),
  // refund tails ("remainder refunded 6 months after birth") and quote
  // validity windows appear across the corpus but belong to the sheet, not
  // to any one payment.
  paymentTerms     Json?
  // Trust gate for the payment schedule, mirroring isFixedCostSource.
  // "ai_proposed" = parsed but unconfirmed (provider-only visibility).
  // "provider_confirmed" = the provider has reviewed/corrected it and it
  // may be shown to parents. "provider_authored" = built from scratch in
  // the editor with no AI involvement (also parent-visible).
  scheduleSource   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            CostItem[]
  tranches         CostTranche[]
  provider         Provider      @relation(fields: [providerId], references: [id])
  providerType     ProviderType? @relation(fields: [providerTypeId], references: [id])
  parentClient     User?         @relation("CostSheetQuotes", fields: [parentClientId], references: [id])
  program          CostProgram?  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model CostItem {
  id                  String            @id @default(uuid())
  providerCostSheetId String
  templateFieldId     String?
  category            String
  key                 String
  minValue            Float?
  maxValue            Float?
  isCustom            Boolean           @default(false)
  comment             String?
  isIncluded          Boolean           @default(true)
  sortOrder           Int               @default(0)
  // True for items that represent alternative pricing tiers (e.g. "Single
  // Cycle / Two Cycles / Three Cycles / Unlimited Transfers"). They are
  // mutually-exclusive choices, not additive line items - the parent picks
  // one. Provider editor groups them in a dedicated Pricing Tiers section;
  // parent grid emits one card per tier.
  isTier              Boolean           @default(false)
  // Recurring / drip payments (pattern F in the payment-schedule taxonomy).
  // A stream, not a tranche - modelling "10 monthly installments after
  // fetal heartbeat" or "$300/month commencing the 26th week" as tranches
  // would produce a 40-row timeline. Shape:
  //   { amountCents, period: "WEEKLY"|"MONTHLY", count?, startTrigger?,
  //     startWeek?, note? }
  // Purely descriptive - never affects the item's min/maxValue or any total.
  recurrence          Json?
  providerCostSheet   ProviderCostSheet @relation(fields: [providerCostSheetId], references: [id], onDelete: Cascade)
  templateField       CostTemplate?     @relation(fields: [templateFieldId], references: [id], onDelete: SetNull)
  payments            CostItemPayment[]
}

/// One payment in a cost sheet's installment plan.
///
/// CORE INVARIANT: a tranche NEVER contributes to any total. The program
/// total stays derived from CostItem rows exactly as it always has - a
/// tranche is a *view over money already counted*, holding a stated amount
/// for display and references to the items it covers. Every total-cost
/// path, matcher and invoice is therefore unaffected by schedules, and the
/// double-count class of bug (installment rows summed as if they were
/// extra line items) is structurally impossible rather than prompt-enforced.
model CostTranche {
  id                  String            @id @default(uuid())
  providerCostSheetId String
  sortOrder           Int               @default(0)
  // Provider's own label: "First Deposit", "Opening Installment to Escrow",
  // "2nd deposit", "Second Payment".
  name                String
  // Canonical milestone from PAYMENT_TRIGGERS (payment-schedule-config.ts).
  // "OTHER" whenever the document's trigger doesn't map cleanly - the
  // verbatim triggerLabel then carries the whole meaning.
  triggerType         String            @default("OTHER")
  // The provider's exact words: "within 5 days of legal sign off, before
  // legal clearance issue". Always retained and always displayed - no enum
  // holds this much nuance, and parents are making financial plans off it.
  triggerLabel        String?
  // "within 5 business days AFTER", "two weeks BEFORE cycle start".
  offsetDays          Int?
  offsetBasis         String?           @default("CALENDAR") // "CALENDAR" | "BUSINESS"
  offsetDirection     String?           @default("AFTER") // "AFTER" | "BEFORE"
  // Stated amount, as a range - Genesis and Love & Kindness state tranches
  // as ranges up to $41k wide. Null when amountBasis derives the figure.
  minValueCents       Int?
  maxValueCents       Int?
  // How the amount is arrived at:
  //   STATED       - the document prints a figure (most common)
  //   SUM_OF_ITEMS - derive by summing the assigned items
  //   REMAINDER    - "the remaining balance" (NEFI deposit-plus-remainder)
  //   PERCENT_OF   - a percentage of assigned items (Genesis 80/20 split)
  //   TBD          - stated as variable/unknown
  amountBasis         String            @default("STATED")
  // Who the money actually goes to. Not cosmetic: most surrogacy tranches
  // fund an ESCROW account that then disburses, and OneWorld tags every
  // line with a distinct payee (agency / escrow / attorney / broker / GC).
  // Rendering "Payment 1: $62,300" against the provider's name would
  // misstate who holds the money on the largest financial decision these
  // parents make.
  payTo               String            @default("PROVIDER")
  payToLabel          String?
  isRefundable        Boolean?
  refundNote          String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  providerCostSheet   ProviderCostSheet @relation(fields: [providerCostSheetId], references: [id], onDelete: Cascade)
  itemPayments        CostItemPayment[]

  @@index([providerCostSheetId, sortOrder])
}

/// Join between a line item and the tranche(s) that pay for it.
///
/// Many-to-many with amounts, because the corpus demands it: one fee is
/// routinely split across several tranches (NESA's $18,000 agency fee across
/// four due-dates; Genesis paying 80% of surrogate compensation in deposit 2
/// and 20% in deposit 3), and one tranche holds parts of several items. A
/// nullable trancheId on CostItem could not express either case.
model CostItemPayment {
  id            String      @id @default(uuid())
  costItemId    String
  trancheId     String
  // Portion of the item due in this tranche. Both null = the whole item.
  minValueCents Int?
  maxValueCents Int?
  // For PERCENT_OF splits: 80 in tranche 2, 20 in tranche 3. Resolved
  // against the item's own value at render time rather than flattened to a
  // literal, so a per-match personalised schedule stays computable.
  percent       Float?
  // The fragment's own caption from the document: "Retainer w/TSS",
  // "due upon starting medication".
  label         String?
  sortOrder     Int         @default(0)
  costItem      CostItem    @relation(fields: [costItemId], references: [id], onDelete: Cascade)
  tranche       CostTranche @relation(fields: [trancheId], references: [id], onDelete: Cascade)

  @@unique([costItemId, trancheId])
  @@index([trancheId])
}

