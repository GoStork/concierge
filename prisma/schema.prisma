model ReferralFeeConfig {
  id                   String   @id @default(uuid())
  providerId           String
  // Per-service key matching InvoiceLineItem.serviceType:
  // "SURROGACY" | "EGG_DONATION" | "SPERM_DONATION" | "IVF_CLINIC" | "OTHER"
  // A provider has one ReferralFeeConfig row per service they offer, so
  // GoStork can negotiate different terms per service (e.g. flat $1000 on
  // egg donation referrals but 5% on IVF cycles).
  serviceType          String   @default("OTHER")
  feeType              String // "FLAT" | "PERCENTAGE"
  flatAmount           Decimal? // in cents (e.g. 50000 = $500.00)
  percentage           Decimal? // e.g. 5.0 = 5%
  defaultServiceAmount Decimal? // pre-fill for first payment in cents - used when parentPaysBasis = DEFAULT_FIRST_PAYMENT
  parentPaysBasis      String   @default("DEFAULT_FIRST_PAYMENT") // "DEFAULT_FIRST_PAYMENT" | "TOTAL_COST" - which value the parent's invoice charges
  sampleTotalCostCents Int? // admin-saved sample value for the preview - not used in any live invoice math
  currency             String   @default("USD")
  isActive             Boolean  @default(true)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([providerId, serviceType])
  @@index([providerId])
}

model Invoice {
  id                  String  @id @default(uuid())
  paymentToken        String  @unique @default(uuid())
  providerId          String
  parentUserId        String
  sessionId           String
  referralFeeConfigId String?

  // Amounts stored in cents to avoid floating point issues
  serviceAmount        Int // what the parent pays for this invoice
  referralFeeAmount    Int // GoStork's cut
  providerPayoutAmount Int // serviceAmount - referralFeeAmount
  quotedTotalCostCents Int? // snapshot of the ProviderQuote.totalCostCents used as the fee basis (PERCENTAGE configs)
  providerQuoteId      String? // FK to the ProviderQuote that was active when this invoice was created
  triggerSource        String  @default("PROVIDER_MANUAL") // "PROVIDER_MANUAL" | "ADMIN_MANUAL" | "AUTO_READINESS"
  currency             String  @default("USD")

  // Invoice metadata shown to parent
  serviceType  String // "IVF Treatment" | "Egg Donation" | "Sperm Donation" | "Surrogacy"
  providerName String // snapshot at invoice creation time
  description  String?
  dueAt        DateTime? // 24h for surrogacy AT_MATCH, null otherwise

  // Status: AWAITING_PAYMENT | PAYMENT_PROCESSING | AUTHORIZED | PAID | CLEARANCE_FAILED | EXPIRED | CANCELLED | PARTIALLY_REFUNDED | REFUNDED
  // PAYMENT_PROCESSING is the in-flight state for delayed-notification methods
  // (ACH Direct Debit). The intent is accepted but funds take 3-5 business days
  // to clear, during which the invoice sits in PAYMENT_PROCESSING. It flips to
  // PAID on payment_intent.succeeded, or back via payment_failed on bounce.
  status        String  @default("AWAITING_PAYMENT")
  paymentMethod String? // "CARD" | "ACH"

  // Stripe
  stripeTransactionId   String? @unique
  stripePaymentIntentId String? // AT_CLEARANCE: pre-auth PI ID before capture
  stripePaymentLinkUrl  String?

  // Bank-transfer (customer_balance) path. Kept separate from the card
  // PaymentIntent above so a parent who started a wire flow can still see
  // their cached wire instructions on page reload, or switch back to card
  // without us losing the wire intent. wireInstructionsJson stores the
  // financial_addresses + reference returned by Stripe so we never need to
  // re-confirm the intent just to redisplay the wire details.
  stripeWirePaymentIntentId String?
  wireInstructionsJson      Json?

  // GoStork Guarantee / Escrow
  isProtected                  Boolean   @default(true)
  medicalClearanceStatus       String? // null | "PENDING" | "CLEARED" | "FAILED"
  clearanceConfirmedAt         DateTime?
  creditTransferredToInvoiceId String?

  // Dwolla (Phase 2 - ACH)
  dwollaPaymentTransferUrl String?
  dwollaPayoutTransferUrl  String?

  // Stripe Connect transfer: when invoice flips to PAID and the provider's
  // ProviderBankAccount.payoutsEnabled is true, we call transfers.create to
  // push the provider's cut from GoStork's platform balance to their
  // connected account. The provider's Stripe Connect payout schedule then
  // moves it to their bank.
  stripeTransferId    String?   @unique
  payoutFailedAt      DateTime?
  payoutFailureReason String?
  // Auto-retry bookkeeping: when the platform balance can't cover the
  // transfer yet (funds still settling), we DON'T stamp a failure - we
  // schedule the next automatic attempt here and the payout-retry
  // scheduler picks it up. attemptCount drives the backoff ladder; after
  // the ladder is exhausted the invoice flips to a real failure
  // (payoutFailedAt) and lands in the admin Needs-attention queue.
  payoutNextAttemptAt DateTime?
  payoutAttemptCount  Int       @default(0)

  // Bank-side settlement: when Stripe sweeps the connected account's
  // balance to the provider's bank (a Stripe Payout, distinct from the
  // platform->Connect Transfer above), payout.paid fires on the connected
  // account. We list the payout's balance transactions on the connected
  // account and match each one's `source` (a py_xxx charge id) against
  // Invoice.stripeConnectPaymentId, which we stamped at transfer time.
  // payout.failed sets bankPayoutFailedAt + reason. Note: one bank-side
  // Payout can cover many Transfers, so multiple invoices share the
  // same stripeBankPayoutId.
  //
  // stripeConnectPaymentId = Transfer.destination_payment - the Charge id
  // on the connected account (py_xxx) corresponding to our platform-side
  // transfer (tr_xxx). Necessary for matching balance transactions back
  // to invoices on the payout.paid webhook.
  stripeConnectPaymentId  String?   @unique
  stripeBankPayoutId      String?
  bankPayoutCompletedAt   DateTime?
  bankPayoutFailedAt      DateTime?
  bankPayoutFailureReason String?

  // Refunds: admin issues refund via /api/admin/invoices/:id/refund -> Stripe
  // refunds.create -> charge.refunded webhook stamps these fields. Supports
  // partial refunds via accumulation: refundedAmount is the running total of
  // all refunds against this invoice's payment (matches Stripe's
  // charge.amount_refunded), stripeRefundId is the most-recent refund.
  //
  // Status transitions: PAID -> PARTIALLY_REFUNDED (refundedAmount < serviceAmount)
  // -> REFUNDED (refundedAmount === serviceAmount).
  //
  // When the provider's transfer already fired, we also create a
  // proportional Transfer reversal so GoStork doesn't eat the loss. Stripe
  // reverses from the connected account's balance, or debits it negative if
  // the funds already swept to bank (Stripe recoups on the next payout).
  refundedAt           DateTime?
  refundedAmount       Int? // cents; matches charge.amount_refunded
  refundReason         String? // Stripe enum: duplicate | fraudulent | requested_by_customer | other
  refundNotes          String? // free-text from admin, internal-only
  stripeRefundId       String? // re_xxx, the most recent refund
  payoutReversalId     String? // trr_xxx, the most recent transfer reversal
  payoutReversedAt     DateTime?
  payoutReversedAmount Int? // cents reversed back to platform; ≤ providerPayoutAmount

  // Recoupment tracking. When a Transfer Reversal hits an invoice whose
  // bank-side Payout has already completed (Received status), Stripe
  // does NOT pull money out of the provider's bank - it creates a
  // negative balance on the connected account that gets recouped from
  // future incoming transfers. Until recouped, GoStork is essentially
  // extending uncollateralized credit to the provider. We flag these
  // invoices and a periodic monitor stamps recouped when the provider's
  // Connect balance is no longer negative.
  payoutReversalAtRisk     Boolean   @default(false)
  payoutReversalRecoupedAt DateTime?

  // Timestamps
  authorizedAt      DateTime?
  capturedAt        DateTime?
  paidAt            DateTime?
  payoutInitiatedAt DateTime?
  payoutCompletedAt DateTime?

  adminNotes     String?
  manualOverride Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider          Provider           @relation(fields: [providerId], references: [id])
  parentUser        User               @relation(fields: [parentUserId], references: [id])
  session           AiChatSession      @relation(fields: [sessionId], references: [id])
  referralFeeConfig ReferralFeeConfig? @relation(fields: [referralFeeConfigId], references: [id])
  providerQuote     ProviderQuote?     @relation(fields: [providerQuoteId], references: [id])
  reminders         InvoiceReminder[]
  agreement         Agreement?
  lineItems         InvoiceLineItem[]

  @@index([providerId])
  @@index([parentUserId])
  @@index([sessionId])
  @@index([status])
  @@index([paymentToken])
}

// Itemized lines on a single invoice. Lets an agency bill multiple services
// (e.g. "Surrogacy reservation deposit" + "Legal coordination" + "Genetic
// counseling") on one invoice. The Invoice.serviceAmount is the sum of all
// line items, and serviceType on Invoice is the primary/headline service so
// the rest of the codebase that hasn't been updated to read lineItems still
// renders something sensible.
model InvoiceLineItem {
  id           String   @id @default(uuid())
  invoiceId    String
  // Fixed set: "SURROGACY" | "EGG_DONATION" | "SPERM_DONATION" | "IVF_CLINIC" | "OTHER"
  serviceType  String
  description  String?
  amountCents  Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ProviderQuote {
  id                   String    @id @default(uuid())
  sessionId            String
  providerId           String
  parentUserId         String
  totalCostCents       Int
  costSheetFileUrl     String?
  costSheetFileName    String?
  notes                String?
  source               String    @default("PROVIDER") // "PROVIDER" | "ADMIN_OVERRIDE" | "AUTO_DRAFT_APPROVED"
  createdByUserId      String?
  supersededAt         DateTime?
  // Phase 2 auto-draft additions:
  // - parentAcknowledgedAt: stamped when parent clicks "Acknowledge" on
  //   the cost-sheet card (Stage 5). Soft signal only - call proceeds
  //   either way.
  // - lineItems: structured line items, JSON array of
  //   { label: string, amountCents: number, editable?: boolean }
  // - sourceCostSheetId: which ProviderCostSheet (template) this quote
  //   was generated from. Null for legacy / fully-manual sends.
  // - autoDraftedAt: when the AI initially drafted this quote, before
  //   provider approval. Null if the provider sent manually.
  parentAcknowledgedAt DateTime?
  lineItems            Json?
  sourceCostSheetId    String?
  autoDraftedAt        DateTime?
  // Number of priced units the total represents (e.g. 2 sperm vials, 3 egg
  // lots). Defaults to 1 for legacy / manually-entered totals. FLAT referral
  // fees scale by this multiplier so a 2-vial quote also doubles GoStork's
  // flat fee. PERCENTAGE fees ignore it - they already scale with the total.
  quantity             Int       @default(1)
  createdAt            DateTime  @default(now())

  session       AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  provider      Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  parentUser    User          @relation("ProviderQuoteParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("ProviderQuoteCreatedBy", fields: [createdByUserId], references: [id])
  invoices      Invoice[]

  @@index([sessionId])
  @@index([providerId])
  @@index([sessionId, createdAt])
  @@index([sourceCostSheetId])
}

model CostSheetReminder {
  id        String   @id @default(uuid())
  sessionId String
  bookingId String? // null for POST_READINESS_BLOCKED reminders
  window    String // "24H_BEFORE" | "1H_BEFORE" | "POST_READINESS_BLOCKED"
  sentAt    DateTime @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  booking Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([sessionId, bookingId, window])
  @@index([sessionId])
}

model InvoiceReminder {
  id           String   @id @default(uuid())
  invoiceId    String
  sentAt       DateTime @default(now())
  channel      String // "chat" | "email" | "sms"
  reminderType String // "initial" | "followup_24h" | "followup_48h" | "followup_72h" | "12h_remaining" | "4h_remaining" | "1h_remaining" | "expired" | "clearance_day14" | "clearance_day21"

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Provider payout setup. One row per provider. Two payout methods are
// supported via the `payoutMethod` switch:
//
//   STRIPE_CONNECT_EXPRESS - provider goes through Stripe-hosted onboarding
//     (account link redirect). They end up with a minimal Stripe Express
//     dashboard. Best for tech-comfortable providers.
//
//   STRIPE_CONNECT_CUSTOM - provider fills out a GoStork form (business
//     address + representative info + bank routing/account); GoStork creates
//     the Connect account behind the scenes with controller.dashboard.type
//     = "none" so the provider never sees Stripe at all. Best for
//     conservative providers (most fertility agencies).
//
// In both cases the underlying money flow is identical: parent pays via
// Stripe Checkout/Element, funds land in GoStork's Stripe balance, then
// stripe.transfers.create pushes the provider's cut to their Connect
// account. Stripe then auto-pays out from the Connect account to the
// provider's bank per their payout schedule.
model ProviderBankAccount {
  id                         String    @id @default(uuid())
  providerId                 String    @unique
  // "STRIPE_CONNECT_EXPRESS" | "STRIPE_CONNECT_CUSTOM" | null (not yet picked)
  payoutMethod               String?
  // Stripe Connect account ID (acct_...). Same column for both Express and
  // Custom - the Stripe account itself doesn't differ, only the controller
  // config we passed at creation time.
  stripeConnectAccountId     String?   @unique
  // Mirrored from Stripe's accounts.retrieve response so the UI can render
  // status without an extra Stripe round-trip per page load:
  //   payoutsEnabled = capabilities.transfers.status === "active"
  //   chargesEnabled = charges_enabled (informational only - we don't
  //     accept charges on the connected account, but Stripe surfaces it)
  payoutsEnabled             Boolean   @default(false)
  chargesEnabled             Boolean   @default(false)
  detailsSubmitted           Boolean   @default(false)
  // requirements.currently_due[] - list of field IDs Stripe still needs from
  // the account (e.g. "individual.dob.day", "external_account",
  // "individual.verification.document"). For Custom path we render these
  // as inline fields in the GoStork form; for Express we just deep-link
  // back into Stripe-hosted onboarding.
  requirementsCurrentlyDue   Json      @default("[]")
  // requirements.eventually_due[] - fields not yet blocking but Stripe will
  // ask for them before a future deadline.
  requirementsEventuallyDue  Json      @default("[]")
  // requirements.past_due[] - fields blocking AND past the deadline; payouts
  // get paused until these are submitted.
  requirementsPastDue        Json      @default("[]")
  // requirements.disabled_reason - non-null when the account is restricted.
  requirementsDisabledReason String?
  // Snapshot of the linked bank for display ("Chase **** 1234"). Pulled
  // from external_accounts on account.updated. Never the source of truth.
  bankName                   String?
  accountLast4               String?
  accountType                String? // "checking" | "savings"
  onboardingStartedAt        DateTime?
  onboardingCompletedAt      DateTime? // first time payoutsEnabled flipped to true
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// Per-provider W-9 record. Mirrors the agreement signing flow, but GoStork is the
// sender (template owner) and the agency is the signer. One row per provider.
model ProviderW9 {
  id                 String    @id @default(uuid())
  providerId         String    @unique
  pandaDocDocumentId String?   @unique
  pandaDocViewUrl    String?
  status             String    @default("NOT_SENT") // NOT_SENT | SENT | COMPLETED | ERROR
  signerEmail        String?
  signerUserId       String?
  requestedByUserId  String? // GoStork admin who sent the request; null if provider self-initiated
  requestedAt        DateTime?
  completedAt        DateTime?
  // Snapshot of SiteSettings.w9TemplateUpdatedAt at the time this PandaDoc doc
  // was created. When the admin updates the template, ensureW9Document() sees
  // this mismatch and regenerates the doc so providers always sign the latest.
  templateUpdatedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// ─── Profile Sponsorship ─────────────────────────────────────────────────────
// Providers pay GoStork monthly to boost their profiles in the marketplace.
// Two products: SLOT_BUNDLE (a pool of slots filled with individual sub-profiles
// - donors/surrogates/sperm donors/doctors) and WHOLE_PROFILE (the provider's own
// clinic/agency top-level profile, priced per provider type). Source of truth is
// Sponsorship + SponsorshipItem; the boost is denormalized onto each entity's
// sponsoredUntil column for cheap marketplace reads.

enum SponsorshipProductType {
  SLOT_BUNDLE
  WHOLE_PROFILE
}

enum SponsorshipBillingMode {
  AUTO_RENEW
  ONE_TIME
}

enum SponsorshipStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum SponsoredEntityType {
  EGG_DONOR
  SURROGATE
  SPERM_DONOR
  DOCTOR
  CLINIC_PROFILE
  AGENCY_PROFILE
}

// Pricing config (editable by admins without a code change). Seeded from
// server/sponsorship-plan-defaults.ts using create-if-not-exists (never overwrite).
model SponsorshipPlan {
  id              String                 @id @default(uuid())
  productType     SponsorshipProductType
  tierKey         String // e.g. "egg_donor_starter" | "surrogate_single" | "doctor_practice" | "whole_profile_ivf"
  // For SLOT_BUNDLE plans this scopes the bundle to ONE sub-profile type (egg
  // donors vs surrogates vs sperm donors vs doctors) so tiers can be sized to
  // each roster. Null for WHOLE_PROFILE plans.
  slotEntityType  SponsoredEntityType?
  displayName     String
  priceCents      Int
  currency        String                 @default("USD")
  slotCount       Int // per-type tier size ; 1 for WHOLE_PROFILE
  stripeProductId String?
  stripePriceId   String? // pre-provisioned recurring Price (optional; else created on the fly)
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sponsorships    Sponsorship[]

  @@unique([productType, tierKey])
}

// One row per purchase (subscription or one-time month).
model Sponsorship {
  id                    String                 @id @default(uuid())
  providerId            String
  planId                String
  productType           SponsorshipProductType
  billingMode           SponsorshipBillingMode
  status                SponsorshipStatus      @default(PENDING_PAYMENT)
  // Pricing snapshot at purchase so later plan edits never retro-reprice this sub.
  priceCentsSnapshot    Int
  currency              String                 @default("USD")
  slotCountSnapshot     Int
  // Lifecycle windows
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime? // = boost expiry for this period
  canceledAt            DateTime? // auto-renew turned off; runs out at currentPeriodEnd
  endedAt               DateTime? // fully expired/terminated
  // Stripe linkage
  stripeCustomerId      String?
  stripeSubscriptionId  String?                @unique // AUTO_RENEW only
  stripePaymentIntentId String? // ONE_TIME only
  stripePriceId         String?
  // Comp + provenance
  isComped              Boolean                @default(false)
  compedByUserId        String?
  compReason            String?
  createdByAdmin        Boolean                @default(false)
  createdByUserId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  provider Provider          @relation(fields: [providerId], references: [id])
  plan     SponsorshipPlan   @relation(fields: [planId], references: [id])
  items    SponsorshipItem[]

  @@index([providerId, status])
  @@index([status, currentPeriodEnd])
  @@index([stripeSubscriptionId])
}

// Each filled slot. entityId is FK-by-convention to the target table's id.
// WHOLE_PROFILE = a single item with entityType CLINIC_PROFILE|AGENCY_PROFILE, entityId = providerId.
model SponsorshipItem {
  id            String              @id @default(uuid())
  sponsorshipId String
  entityType    SponsoredEntityType
  entityId      String
  addedAt       DateTime            @default(now())
  removedAt     DateTime? // soft-remove frees the slot, preserves history

  sponsorship Sponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)

  @@unique([sponsorshipId, entityType, entityId])
  @@index([entityType, entityId])
}

// Phase 4: admin-uploaded concierge documents (e.g. the Match Call prep
// guide PDF sent to parents when a match call is scheduled). One row per
// well-known key; re-uploading replaces the file.
model ConciergeAsset {
  id               String   @id @default(uuid())
  key              String   @unique // e.g. "match_call_prep_guide"
  fileName         String
  objectPath       String // GCS object path - served via signed-URL redirect
  contentType      String   @default("application/pdf")
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Dismissed rows in the GoStork admin Home "Needs attention" queue.
// taskKey encodes the item identity INCLUDING its occurrence timestamp
// (e.g. "failed-payout:<invoiceId>:<failedAtMs>") so a dismissed item
// reappears if the same underlying thing happens again later.
model AdminTaskDismissal {
  id          String   @id @default(uuid())
  taskKey     String   @unique
  dismissedBy String?
  dismissedAt DateTime @default(now())
}

// Phase 7A: append-only journey event log. Every notable event in a parent's
// journey with a provider - booking lifecycle + call outcomes, invoices,
// agreements, matches, favorites, whispers, lawyer connect, bank checkout,
// win-backs, churn reasons. Journey STAGES are derived from these plus
// source-of-truth records; rows here are never updated or deleted.
model JourneyEvent {
  id              String   @id @default(uuid())
  parentAccountId String
  providerId      String?
  sessionId       String?
  bookingId       String?
  eventType       String
  actorRole       String? // "parent" | "provider" | "system" | "admin"
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([parentAccountId, createdAt])
  @@index([providerId, eventType, createdAt])
  @@index([bookingId])
  @@index([eventType, createdAt])
}

// ─── Intended Parent Form ────────────────────────────────────────────────────
// Surrogacy agencies require intended parents to complete a long profile form
// (personal info, embryo details, surrogate expectations, letter to the
// surrogate, photos, per-parent signatures). The agency downloads a PDF
// branded with THEIR logo and sends it to surrogate candidates ahead of a
// match call - no submitted form, no match call.
//
// One GLOBAL template (GoStork-admin editable at /admin/ip-form-template);
// sections+questions ARE the template. Seeded from server/ip-form-defaults.ts
// with create-if-missing semantics (admin edits are never overwritten).
// One submission per parent account; per-agency branding (logo + agency name
// in the acknowledgment legal text) is applied at PDF render time.

model IpFormSection {
  id                      String   @id @default(uuid())
  key                     String   @unique // stable: "profile" | "clinic" | "embryo" | "personal_info" | "expectations" | "delivery" | "letter" | "photos" | "private" | "acknowledgment"
  title                   String
  description             String? // e.g. private section: "This information will NOT be shared with the surrogate."
  sortOrder               Int      @default(0)
  // Whole section repeats once per parent (personal_info, acknowledgment).
  perParent               Boolean  @default(false)
  // Section stripped from the surrogate-facing PDF variant (private section).
  excludeFromSurrogatePdf Boolean  @default(false)
  // Program types this section applies to (e.g. ["surrogacy"], ["surrogacy","ivf"]).
  // Empty = core: shown to every parent regardless of their providers' program.
  // A parent sees a section when it is core OR its appliesTo intersects the set
  // of program types across the providers they've consulted.
  appliesTo               String[] @default([])
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  questions IpFormQuestion[]
}

model IpFormQuestion {
  id                      String   @id @default(uuid())
  sectionId               String
  key                     String   @unique // stable, e.g. "ip_full_legal_name", "embryo_count"
  label                   String
  helpText                String?
  widget                  String // "text" | "textarea" | "yes_no" | "dropdown" | "date" | "address" | "phone" | "number" | "photos"
  options                 Json? // dropdown choices: string[]
  required                Boolean  @default(false)
  // Question repeats per parent inside a SHARED section (section-1 IP1/IP2
  // profile blocks). Questions inside a perParent SECTION are per-parent
  // implicitly and should leave this false.
  perParent               Boolean  @default(false)
  // Answer stripped from the surrogate-facing PDF variant (emails, phones,
  // addresses, DOB, ID document fields).
  excludeFromSurrogatePdf Boolean  @default(false)
  // Conditional follow-up: shown only when the parent question's answer
  // equals conditionalTriggerValue (covers every "If yes, please explain").
  conditionalOnQuestionId String?
  conditionalTriggerValue String?
  sortOrder               Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  section IpFormSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers IpFormAnswer[]

  @@index([sectionId, sortOrder])
}

// One per parent account (FK-by-convention like JourneyEvent).
model IpFormResponse {
  id                    String    @id @default(uuid())
  parentAccountId       String    @unique
  status                String    @default("DRAFT") // "DRAFT" | "SUBMITTED"
  // Whether a second intended parent is on this journey. Derived from IP1's
  // marital status (Partnered/Married => two) so parents skip a redundant
  // upfront question - UNLESS hasSecondParentManual is set, in which case the
  // parent's explicit choice (the escape hatch) wins and derivation stops.
  hasSecondParent       Boolean   @default(true)
  hasSecondParentManual Boolean   @default(false)
  parent2Mode           String? // "member" | "guest"
  promptedAt            DateTime? // when Eva's card was posted - anchors the reminder ladder
  submittedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  answers     IpFormAnswer[]
  signatures  IpFormSignature[]
  guestTokens IpFormGuestToken[]
  reminders   IpFormReminder[]
}

model IpFormAnswer {
  id              String   @id @default(uuid())
  responseId      String
  questionId      String
  // 0 = shared answer; 1 | 2 for per-parent questions/sections. Not
  // nullable: NULL inside the compound unique would let duplicate shared
  // rows through (Postgres treats NULLs as distinct) and Prisma cannot
  // target a null member in upsert's compound-unique where.
  parentSlot      Int      @default(0)
  // string | boolean-ish "yes"/"no" | {address,city,state,zip,country} |
  // {e164,display} for phone | [url, ...] for photos.
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  response IpFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question IpFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId, parentSlot])
  @@index([responseId])
}

model IpFormSignature {
  id                String   @id @default(uuid())
  responseId        String
  parentSlot        Int // 1 | 2
  fullLegalName     String
  signatureImageUrl String // PNG uploaded via POST /api/uploads (canvas export or typed-name render)
  method            String // "drawn" | "typed"
  signedAt          DateTime @default(now())
  signedByUserId    String? // null when signed via guest link
  guestTokenId      String?

  response IpFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, parentSlot])
}

// Tokenized guest access for parent 2 (no GoStork account). 256-bit token,
// 30-day expiry, revoked on submit and on re-invite.
model IpFormGuestToken {
  id           String    @id @default(uuid())
  responseId   String
  token        String    @unique
  email        String
  name         String?
  parentSlot   Int       @default(2)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())

  response IpFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}

// Reminder dedupe ledger (pattern: InvoiceReminder). The 10-min sweep runs on
// multiple machines; the unique constraint makes sends idempotent.
model IpFormReminder {
  id           String   @id @default(uuid())
  responseId   String
  channel      String // "email" | "sms" | "inapp"
  reminderType String // "day3" | "day7" | "day14" | "day28" | "day42" | "day56"
  sentAt       DateTime @default(now())

  response IpFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, reminderType, channel])
  @@index([responseId])
}

// One row per stored photo, keyed by the persisted URL. Holds a 64-bit dHash
// (as 16 hex chars) so the sync can tell that two different files are the same
// picture - agencies routinely carry one photo at two resolutions, which the
// md5-named GCS objects cannot collapse because the bytes genuinely differ.
//
// Cached rather than computed per sync: fingerprinting means downloading the
// image, and a profile's photos almost never change. `failed` marks an object
// we could not read or decode so a broken file is not re-fetched on every run.
model PhotoFingerprint {
  url       String   @id
  phash     String? // 16 hex chars = 64-bit dHash; null when failed
  /// Base64 of a 32x32 greyscale thumbnail. Comparing these (normalised
  /// correlation) is what actually decides "same picture": a 64-bit hash puts a
  /// re-encoded copy at distance 5 and a genuinely different photo at 10, which
  /// is too close to separate safely. On the same pairs the thumbnails score
  /// 0.995+ for copies and below 0.82 for different photos.
  thumb     String?
  width     Int?
  height    Int?
  bytes     Int?
  failed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phash])
}

/// One request to an agency to confirm a manually-uploaded surrogate is still
/// available, and what they said. See
/// docs/surrogate-availability-verification.md for the whole design.
///
/// Only upload-only surrogates are ever asked about (Surrogate.lastFullSyncAt
/// is null); scraped profiles are corrected by the nightly sync, and asking
/// about those trains coordinators to ignore the request.
model SurrogateVerification {
  id            String    @id @default(uuid())
  surrogateId   String
  providerId    String
  /// PARENT_SAVE (a parent just saved her - answer urgently) or SWEEP (the
  /// periodic digest backstop).
  trigger       String
  requestedAt   DateTime  @default(now())
  /// Reminders already sent. Two, then a 14-day grace, then auto-PENDING.
  reminderCount Int       @default(0)
  respondedAt   DateTime?
  /// The user id of the coordinator who answered.
  respondedBy   String?
  /// The status they chose, from the marketplace filter vocabulary:
  /// AVAILABLE | ON_HOLD | PENDING | MATCHED | INACTIVE.
  resultStatus  String?
  /// Set when nobody answered and the profile was auto-moved to PENDING, so a
  /// coordinator can tell an automatic change from one they made.
  autoHiddenAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([surrogateId, requestedAt])
  @@index([providerId, respondedAt])
}
