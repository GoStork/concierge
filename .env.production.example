# GoStork 2.0 production environment - TEMPLATE (no secret values committed).
# Fill on the GCP host (or its secret manager). Legend per line:
#   [copy]  = same value as the dev .env
#   [fresh] = generate NEW for production, never reuse dev
#   [prod]  = production-specific value, see note
# See docs/production-launch-runbook.md sections 2 and 11.

# ── Environment identity ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
# [prod] Phase A: https://test-app.gostork.com  ->  Phase B: https://app.gostork.com
APP_URL=
# NEVER set PASSIVE_MODE here - production sends email/SMS and runs schedulers.
# ENABLE_NIGHTLY_SCHEDULER stays unset - nightly sync via external pinger.

# ── Database (NEW production Supabase project - NOT dev bryzqwfzvgjenijciwaa)
DATABASE_URL=            # [prod] pooled URI from the new project
DIRECT_URL=              # [prod] direct (non-pooled) URI - prisma migrate needs it
SUPABASE_URL=            # [prod] new project URL
SUPABASE_ANON_KEY=       # [prod] new project
SUPABASE_SERVICE_ROLE_KEY=  # [prod] new project

# ── Auth / crypto (ALL FRESH - never reuse dev values in production) ──────
SESSION_SECRET=          # [fresh]
JWT_SECRET=              # [fresh]
FIELD_ENCRYPTION_KEY=    # [fresh] encrypts SSN/passport at rest - once set, NEVER rotate casually (breaks decryption)
CALDAV_ENCRYPTION_KEY=   # [fresh] same warning - encrypts Apple calendar creds

# ── Bot protection ────────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=      # [prod] widget must allow test-app.gostork.com AND app.gostork.com
TURNSTILE_SECRET_KEY=    # [prod]

# ── Email ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=        # [copy]
SENDGRID_FROM_EMAIL=     # [copy]

# ── SMS / voice (Twilio) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=      # [copy]
TWILIO_AUTH_TOKEN=       # [copy]
TWILIO_PHONE_NUMBER=     # [copy] +12058962077
TWILIO_MESSAGING_SERVICE_SID=  # [prod] MGa6b8...0255 until A2P VERIFIED cutover -> then MG6c4e651e006fe5b8a47523b244db96cd
TWILIO_VERIFY_SERVICE_SID=     # [copy] OTP

# ── AI ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=          # [copy]
OPENAI_API_KEY=          # [copy] embeddings
ANTHROPIC_API_KEY=       # [copy]
DEEPGRAM_API_KEY=        # [copy] voice
CARTESIA_API_KEY=        # [copy] voice
ELEVENLABS_API_KEY=      # [copy] voice
HEYGEN_API_KEY=          # [copy] avatar
LIVEAVATAR_API_KEY=      # [copy] avatar
TWOCAPTCHA_API_KEY=      # [copy] scraper captcha solving

# ── Documents / storage ───────────────────────────────────────────────────
PANDADOC_API_KEY=        # [copy]
PANDADOC_WEBHOOK_SECRET= # [prod] the PRODUCTION webhook subscription's shared_key
GCS_SERVICE_ACCOUNT_KEY= # [copy] one-line JSON
GCS_BUCKET_NAME=gostork-recordings
GOOGLE_SERVICE_ACCOUNT=  # [copy] speech-to-text
AWS_ACCESS_KEY_ID=       # [copy] Rekognition (photo dedupe)
AWS_SECRET_ACCESS_KEY=   # [copy]
AWS_REGION=              # [copy]
REKOGNITION_COLLECTION_ID=  # [copy]

# ── Calendar OAuth (redirect URIs must include the production hostnames) ──
GOOGLE_CLIENT_ID=        # [copy] + add prod redirect URIs in Google console
GOOGLE_CLIENT_SECRET=    # [copy]
MICROSOFT_CLIENT_ID=     # [copy] + add prod redirect URIs in Azure portal
MICROSOFT_CLIENT_SECRET= # [copy]

# ── Payments ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=       # [prod] LIVE key (dev uses test mode)
STRIPE_PUBLISHABLE_KEY=  # [prod] LIVE
VITE_STRIPE_PUBLISHABLE_KEY=  # [prod] LIVE (baked into client at BUILD time - build on prod values)
STRIPE_WEBHOOK_SECRET=   # [prod] new live endpoint for this host
STRIPE_CONNECT_WEBHOOK_SECRET=  # [prod] new live Connect endpoint
BRAINTREE_ENVIRONMENT=   # [prod] production (if Braintree still used - verify before launch)
BRAINTREE_MERCHANT_ID=   # [prod]
BRAINTREE_PUBLIC_KEY=    # [prod]
BRAINTREE_PRIVATE_KEY=   # [prod]

# ── Video ─────────────────────────────────────────────────────────────────
DAILY_API_KEY=           # [copy]
DAILY_WEBHOOK_SECRET=    # [prod] if Daily webhooks point at this host

# ── Ops ───────────────────────────────────────────────────────────────────
NIGHTLY_SYNC_SECRET=     # [fresh] shared with the external pinger (GitHub Actions)
GOSTORK_PROVIDER_ID=     # [prod] GoStork house provider id in the PROD DB (same id if seeded via copy)
VITE_LOGODEV_TOKEN=      # [copy] client build-time

# Dev-only keys deliberately ABSENT: REPLIT_DOMAINS, VITE_HMR_HOST,
# TEST_CONCURRENCY, TEST_SERVER_POOL.
